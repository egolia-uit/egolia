{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "course",
  "projectType": "application",
  "tags": ["scope:service", "type:go"],
  "namedInputs": {
    "default": [
      "goPkgFiles",
      "goFiles",
      "{workspaceRoot}/api/**/*.go",
      "{workspaceRoot}/internal/course/**/*.go"
    ],
    "mock": [
      "{workspaceRoot}/internal/course/app/svc_*.go",
      "{workspaceRoot}/internal/course/domain/*repo.go",
      "{workspaceRoot}/internal/course/domain/uow.go"
    ],
    "test": [
      "{projectRoot}/**/*_test.go",
      "{workspaceRoot}/internal/course/**/*_test.go"
    ]
  },
  "targets": {
    "gen:mockery": {
      "executor": "nx:run-commands",
      "inputs": ["mock"],
      "outputs": ["{projectRoot}/**/mock.go"],
      "options": {
        "command": "mockery",
        "cwd": "{projectRoot}"
      }
    },
    "gen:wire": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/wire_gen.go"],
      "options": {
        "command": "wire",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run .",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "dependsOn": ["build-deps"],
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o ./cmd/course/course ./cmd/course/",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "debug": {
          "command": "go build -gcflags='all=-N -l' -o ./cmd/course/__debug_bin ./cmd/course/"
        },
        "development": {
          "command": "go build -o ./cmd/course/course ./cmd/course/"
        },
        "production": {
          "command": "go build -ldflags='-s -w' -o ./cmd/course/course ./cmd/course/"
        }
      },
      "dependsOn": ["gen", "^gen*", "^build*"]
    },
    "build-deps": {
      "executor": "nx:noop",
      "dependsOn": ["gen", "^gen*", "^build*"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./course",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dlv debug --headless --listen=127.0.0.1:23451 --accept-multiclient --output ./cmd/course/__debug_bin ./cmd/course/",
        "tty": true
      },
      "dependsOn": ["build-deps"],
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run ./cmd/course/... ./internal/course/...",
        "forwardAllArgs": true,
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "parallelism": false
    },
    "gen": {
      "dependsOn": ["gen:wire", "gen:mockery"]
    },
    "nx-release-publish": {
      "parallelism": false
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "test"],
      "outputs": ["{workspaceRoot}/coverage/course"],
      "options": {
        "command": "./test.sh",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "./test.sh --production"
        }
      }
    },
    "upload-codecov": {
      "executor": "nx:run-commands",
      "options": {
        "command": "codecov --disable-telem upload-process --disable-search --file ./coverage/course/coverage.out --flag course"
      },
      "dependsOn": ["test"]
    }
  },
  "implicitDependencies": ["pkg"],
  "release": {
    "docker": {
      "repositoryName": "egolia-uit/course"
    }
  }
}
