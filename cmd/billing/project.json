{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "billing",
  "projectType": "application",
  "tags": ["scope:service", "type:go"],
  "namedInputs": {
    "default": [
      "goPkgFiles",
      "goFiles",
      "{workspaceRoot}/api/**/*.go",
      "{workspaceRoot}/internal/billing/**/*.go"
    ],
    "mock": [
      "{workspaceRoot}/internal/billing/app/svc_*.go",
      "{workspaceRoot}/internal/billing/domain/*repo.go",
      "{workspaceRoot}/internal/billing/domain/uow.go"
    ],
    "test": [
      "{projectRoot}/**/*_test.go",
      "{workspaceRoot}/internal/billing/**/*_test.go"
    ]
  },
  "targets": {
    "gen:mockery": {
      "executor": "nx:run-commands",
      "inputs": ["mock"],
      "outputs": ["{projectRoot}/**/mock.go"],
      "options": {
        "command": "mockery",
        "cwd": "{projectRoot}"
      }
    },
    "gen:wire": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/wire_gen.go"],
      "options": {
        "command": "wire",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run .",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "dependsOn": ["build-deps"],
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o ./cmd/billing/billing ./cmd/billing/",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "debug": {
          "command": "go build -gcflags='all=-N -l' -o ./cmd/billing/__debug_bin ./cmd/billing/"
        },
        "development": {
          "command": "go build -o ./cmd/billing/billing ./cmd/billing/"
        },
        "production": {
          "command": "go build -ldflags='-s -w' -o ./cmd/billing/billing ./cmd/billing/"
        }
      },
      "dependsOn": ["gen", "^gen*", "^build*"]
    },
    "build-deps": {
      "executor": "nx:noop",
      "dependsOn": ["gen", "^gen*", "^build*"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./billing",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dlv debug --headless --listen=127.0.0.1:23452 --accept-multiclient --output ./cmd/billing/__debug_bin ./cmd/billing/",
        "tty": true
      },
      "dependsOn": ["build-deps"],
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run ./cmd/billing/... ./internal/billing/...",
        "forwardAllArgs": true,
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "parallelism": false
    },
    "gen": {
      "dependsOn": ["gen:wire", "gen:mockery"]
    },
    "nx-release-publish": {
      "parallelism": false
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "test"],
      "outputs": ["{workspaceRoot}/coverage/billing"],
      "options": {
        "command": "./test.sh",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "./test.sh --production"
        }
      }
    },
    "upload-codecov": {
      "executor": "nx:run-commands",
      "options": {
        "command": "codecov --disable-telem upload-process --disable-search --file ./coverage/billing/coverage.out --flag billing"
      },
      "dependsOn": ["test"]
    }
  },
  "implicitDependencies": ["pkg"],
  "release": {
    "docker": {
      "repositoryName": "egolia-uit/billing"
    }
  }
}
